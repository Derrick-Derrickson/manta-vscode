// A microcontroller.
//
// Two supply pins with default nets, a wide IO bus carrying logic-level
// figures, and one open-drain pin.
part MCU-48 {
    @VERSION       = 1.1+;
    @~footprint    = LQFP-48;
    #value         = STM32F0QA5;
    #!manufacturer = "ST Microelectronics";
    #~mpn          = "STM32F030K6T6";
    >#~source      = digikey;

    [1:48] = IO[1:48]<> #VOH=2V4 #VOL=0V4 #VIH=2V0 #VIL=0V8 &SWAP=bank0;
    49     = SDA<>      &TYPE=OPENDRAIN #VOL=0V6;
    50     = VCC<       &TYPE=POWER &~NET=3V3 #DRAW=25mA;
    51     = GND<       &TYPE=POWER &~NET=GND;
    52     = NC         &TYPE=NC;
};

static part R-10k-1pct-0603 {
    @~footprint = R-0603;
    #value      = 10kR;
    #tolerance  = ±1%;
    #!type      = resistor;

    1 = A &CASUAL;
    2 = B &CASUAL;
};

harness i2c-bus {
    SDA<> &TYPE=OPENDRAIN;
    SCL<> &TYPE=OPENDRAIN;
};

netclass power {
    &CURRENT  = 3A;
    &!VOLTAGE = 60V;
};

match ddr-addr {
    @src       = U1;
    @dest      = [U5, U6, U7];
    @tolerance = 5ps;
};

// A reusable subcircuit.
block rc-filter {
    #~r-value = 10;
    >IN;
    OUT>;
    IN = .{R1~R-$"r-value"$kR-0603}. == .{C1~C-100nF: .=GND} == OUT;
};

block top {
    GND &TYPE=GROUND;
    3V3>>;

    SW == SW-NODE
        = (.{L?~MT100UFA}.)+2
        = (A{D?~DI3643}K)|2
       == ({C?~100nF-0603: .=GND}.)*4
       == 3V3
        = S{Q?~FFET123: G=nPWR-EN; }D
        = PWR-SWITCHED
        &CURRENT=3A &!VOLTAGE=6V &~LAYER=inner1;

    >SIG[0:3] = [[ I{U?~AMP012: EN=%AMP-EN[0:3]; }O ]] = OUT[0:3]>;
    >A[0:3] = [[.{R?~100kR-0603}.]] =* COMBINED>;
    VREF *= BIAS[0:7];
    P = 1{J?~conn-4} ^ {J?~conn-4}1 = Q;
    {!R9~0R-0603};
    3V3 == {U1~MCU-48: SDA=SDA-BUS; }. == GND;
    TP1 = U1.GPIO9 &STUB;
    extern U9.1 = GND;
};

// A connector, and the loom that plugs into it.
part BACKPLANE-OUT {
    @type       = boardconnector;
    @~mate      = jumper-8way;
    @~footprint = HDR-8;

    [1:8] = Q[1:8]<>;
};

part JST-8-PLUG {
    @type  = cableconnector;
    @mates = [BACKPLANE-OUT, BACKPLANE-IN];
    @map   = [[1:8],[8:1]];

    [1:8] = P[1:8]<>;
};

part WIRE-22AWG-RED {
    @type       = wire;
    #csa        = 1mm2;
    #strands    = 7;
    #colour     = red;
    #insulation = PVC;

    1 = A &CASUAL;
    2 = B &CASUAL;
};

cable jumper-8way {
    #length = 300mm;

    {J1~JST-8-PLUG}P[1:8] = [[ .{W%[1:8]~WIRE-22AWG-RED}. ]] = P[1:8]{J2~JST-8-PLUG};
};

---

