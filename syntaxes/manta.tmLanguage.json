{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Manta",
  "scopeName": "source.manta",
  "patterns": [
    { "include": "#end-of-content" },
    { "include": "#comments" },
    { "include": "#declaration" },
    { "include": "#body" }
  ],
  "repository": {
    "end-of-content": {
      "comment": "Spec 2.8: a line of exactly '---' ends the manta content. Everything after is documentation, and is left unhighlighted rather than coloured as though it were code.",
      "begin": "^(---)[ \\t]*$",
      "beginCaptures": {
        "1": { "name": "keyword.control.end-of-content.manta" }
      },
      "end": "\\z",
      "contentName": "comment.block.documentation.manta"
    },

    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.manta",
          "begin": "//",
          "end": "$"
        },
        {
          "comment": "Spec 2.5: block comments do not nest; the first '*/' closes one.",
          "name": "comment.block.manta",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },

    "declaration": {
      "comment": "The five declaration kinds, and the one linkage keyword.",
      "match": "\\b(static)?\\s*\\b(block|part|harness|netclass|match)\\b\\s+([A-Za-z0-9_][A-Za-z0-9_\\-]*)?",
      "captures": {
        "1": { "name": "storage.modifier.linkage.manta" },
        "2": { "name": "keyword.declaration.manta" },
        "3": { "name": "entity.name.type.manta" }
      }
    },

    "body": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#substitution" },
        { "include": "#strings" },
        { "include": "#field" },
        { "include": "#directive" },
        { "include": "#instance" },
        { "include": "#extern" },
        { "include": "#connectors" },
        { "include": "#multiplicity" },
        { "include": "#ports" },
        { "include": "#values" },
        { "include": "#punctuation" }
      ]
    },

    "extern": {
      "match": "\\b(extern)\\b",
      "name": "keyword.control.extern.manta"
    },

    "field": {
      "comment": "Spec 9: '@' is the closed system namespace, '#' the open user one. The strength modifier sits between the sigil and the name, and a '>' either side marks an import or an export.",
      "match": "(>)?([@#])([~!])?([A-Za-z0-9_][A-Za-z0-9_\\-]*)(>)?",
      "captures": {
        "1": { "name": "keyword.operator.import.manta" },
        "2": { "name": "punctuation.definition.field.manta" },
        "3": { "name": "storage.modifier.strength.manta" },
        "4": { "name": "variable.other.field.manta" },
        "5": { "name": "keyword.operator.export.manta" }
      }
    },

    "directive": {
      "comment": "Spec 11: '&' introduces a directive. The namespace is closed, so a known name reads as a keyword and an unknown one still reads as a directive.",
      "patterns": [
        {
          "match": "(&)([~!])?\\b(IMP|CURRENT|PEAK|VOLTAGE|MAXDELAY|CLASS|MATCH|LAYER|SHIELD|TYPE|STUB|PINDELAY|NET|CASUAL|SWAP|HARNESS)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.directive.manta" },
            "2": { "name": "storage.modifier.strength.manta" },
            "3": { "name": "support.type.directive.manta" }
          }
        },
        {
          "match": "(&)([~!])?([A-Za-z0-9_][A-Za-z0-9_\\-]*)",
          "captures": {
            "1": { "name": "punctuation.definition.directive.manta" },
            "2": { "name": "storage.modifier.strength.manta" },
            "3": { "name": "entity.name.function.directive.manta" }
          }
        },
        {
          "comment": "The fixed set of pin-type values, which spec 2.6 requires in upper case.",
          "match": "\\b(POWER|GROUND|OPENDRAIN|SIGNAL|PASSIVE|NC)\\b",
          "name": "constant.language.pintype.manta"
        }
      ]
    },

    "instance": {
      "comment": "Spec 7: a device is '{ designator [~ part] [: bindings] }'. The '~' is what distinguishes declaring an instance from referencing one, so the name after it is the part or block being instantiated.",
      "patterns": [
        {
          "match": "(!)?([A-Za-z_][A-Za-z0-9_\\-]*?)(\\?|[0-9]+|%\\[[0-9,:]*\\])\\s*(~)\\s*([A-Za-z0-9_][A-Za-z0-9_\\-]*)",
          "captures": {
            "1": { "name": "keyword.operator.dnp.manta" },
            "2": { "name": "variable.other.designator.manta" },
            "3": { "name": "constant.numeric.designator.manta" },
            "4": { "name": "keyword.operator.instantiate.manta" },
            "5": { "name": "entity.name.type.instantiated.manta" }
          }
        },
        {
          "comment": "A reference to an instance declared elsewhere: '{U3}'.",
          "match": "(?<=\\{)\\s*(!)?([A-Za-z_][A-Za-z0-9_\\-]*?)(\\?|[0-9]+|%\\[[0-9,:]*\\])(?=\\s*[}:])",
          "captures": {
            "1": { "name": "keyword.operator.dnp.manta" },
            "2": { "name": "variable.other.designator.manta" },
            "3": { "name": "constant.numeric.designator.manta" }
          }
        }
      ]
    },

    "substitution": {
      "comment": "Spec 14: inside '$...$' every operator carries its arithmetic meaning, '-' is always subtraction and '/' is never a comment.",
      "name": "meta.embedded.substitution.manta",
      "begin": "\\$",
      "end": "\\$",
      "beginCaptures": { "0": { "name": "punctuation.definition.substitution.begin.manta" } },
      "endCaptures": { "0": { "name": "punctuation.definition.substitution.end.manta" } },
      "patterns": [
        { "name": "string.quoted.double.manta", "match": "\"[^\"]*\"" },
        { "name": "constant.numeric.manta", "match": "\\b[0-9]+\\b" },
        { "name": "constant.language.boolean.manta", "match": "\\b(true|false)\\b" },
        { "name": "keyword.operator.arithmetic.manta", "match": "[+\\-*/^|&~!<>=]" },
        { "name": "variable.other.field.manta", "match": "[A-Za-z_][A-Za-z0-9_]*" }
      ]
    },

    "strings": {
      "name": "string.quoted.double.manta",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "comment": "Spec 3.5 supports exactly these four escapes.",
          "name": "constant.character.escape.manta",
          "match": "\\\\[\"\\\\nt]"
        },
        { "name": "invalid.illegal.unknown-escape.manta", "match": "\\\\." }
      ]
    },

    "connectors": {
      "comment": "Spec 6. '==' before '=' so the longer operator wins.",
      "patterns": [
        { "name": "keyword.operator.gather.manta", "match": "=\\*" },
        { "name": "keyword.operator.broadcast.manta", "match": "\\*=" },
        { "name": "keyword.operator.same-net.manta", "match": "==" },
        { "name": "keyword.operator.adjacency.manta", "match": "\\^" },
        { "name": "keyword.operator.advance.manta", "match": "=" }
      ]
    },

    "multiplicity": {
      "comment": "Spec 8.6: series, parallel and node multiplicity on a group.",
      "match": "(?<=\\))\\s*([+|*])([0-9]+)",
      "captures": {
        "1": { "name": "keyword.operator.multiplicity.manta" },
        "2": { "name": "constant.numeric.count.manta" }
      }
    },

    "ports": {
      "comment": "Spec 10. A doubled arrow is a global port; the direction depends on which side of the name it sits.",
      "patterns": [
        { "name": "keyword.operator.port.global.manta", "match": ">>" },
        { "name": "keyword.operator.port.bidirectional.manta", "match": "<>" },
        { "name": "keyword.operator.port.manta", "match": "[<>]" }
      ]
    },

    "values": {
      "patterns": [
        {
          "comment": "Spec 3.2: a dimensioned value, in either spelling of a fractional part. '4k7R' and '4.7kR' are the same quantity.",
          "name": "constant.numeric.dimensioned.manta",
          "match": "(?<![A-Za-z0-9_\\-])-?[0-9]+(?:[pnumkMGT][0-9]+)?(?:\\.[0-9]+)?[pnumkMGT]?(?:Hz|R|F|H|V|A|W|m|s|C)D?(?![A-Za-z0-9_\\-])"
        },
        {
          "comment": "A unit whose suffix stands in for the decimal point: '3V3', '1R5'.",
          "name": "constant.numeric.dimensioned.manta",
          "match": "(?<![A-Za-z0-9_\\-])-?[0-9]+(?:Hz|R|F|H|V|A|W|m|s|C)[0-9]+D?(?![A-Za-z0-9_\\-])"
        },
        {
          "name": "constant.numeric.tolerance.manta",
          "match": "(?:±|\\+-)\\s*[0-9]+(?:\\.[0-9]+)?%"
        },
        {
          "comment": "Spec 3.4: manta is metric only, so an imperial literal is an error rather than a value.",
          "name": "invalid.illegal.imperial-unit.manta",
          "match": "(?<![A-Za-z0-9_\\-])-?[0-9]+(?:\\.[0-9]+)?(?:mils?|thou|inch(?:es)?|in|ft|feet|foot|miles?|oz|lb)(?![A-Za-z0-9_\\-])"
        },
        {
          "name": "constant.numeric.manta",
          "match": "(?<![A-Za-z0-9_\\-])-?[0-9]+(?:\\.[0-9]+)?(?![A-Za-z0-9_\\-])"
        },
        {
          "name": "constant.language.boolean.manta",
          "match": "\\b(TRUE|FALSE|true|false)\\b"
        },
        {
          "comment": "Spec 2.3: an identifier shall not end in '-'.",
          "name": "invalid.illegal.trailing-hyphen.manta",
          "match": "\\b[A-Za-z0-9_][A-Za-z0-9_\\-]*-(?![A-Za-z0-9_])"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        { "name": "punctuation.definition.replication.manta", "match": "\\[\\[|\\]\\]" },
        { "name": "punctuation.terminator.statement.manta", "match": ";" },
        { "name": "punctuation.separator.binding.manta", "match": ":" },
        { "name": "punctuation.separator.comma.manta", "match": "," },
        { "name": "keyword.operator.unassigned.manta", "match": "\\?" },
        { "name": "keyword.operator.percopy.manta", "match": "%" },
        { "name": "punctuation.section.braces.manta", "match": "[{}]" },
        { "name": "punctuation.section.brackets.manta", "match": "[\\[\\]]" },
        { "name": "punctuation.section.parens.manta", "match": "[()]" },
        { "name": "punctuation.accessor.manta", "match": "\\." }
      ]
    }
  }
}
